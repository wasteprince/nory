#!/bin/sh
set -e
systemctl daemon-reload || true
# The GUI and helper protocol must be upgraded together. Socket activation
# otherwise keeps the old helper process alive after replacing its executable.
systemctl stop nory-helper.service >/dev/null 2>&1 || true
systemctl enable --now nory-helper.socket >/dev/null 2>&1 || true
systemctl restart nory-helper.socket >/dev/null 2>&1 || true
gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
update-desktop-database -q >/dev/null 2>&1 || true
exit 0
